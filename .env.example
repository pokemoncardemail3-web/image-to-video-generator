# Text-to-Speech API Configuration
# Choose your TTS provider and add the appropriate API key

# Google Cloud TTS
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# ElevenLabs TTS
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI TTS
OPENAI_API_KEY=your_openai_api_key_here

# TTS Provider Selection (google, elevenlabs, openai)
TTS_PROVIDER=google

# Output Configuration
OUTPUT_DIR=./output
TEMP_DIR=./temp

# Video Configuration
VIDEO_BITRATE=2000k
AUDIO_BITRATE=192k
FRAME_RATE=30
